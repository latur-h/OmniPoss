<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<UseWindowsForms>true</UseWindowsForms>
	<ApplicationIcon>Icons\favicon.ico</ApplicationIcon>
	<NoWin32Manifest>true</NoWin32Manifest>
    <!-- Exclude debug symbols from publish output -->
	  <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>


  <ItemGroup>
    <Content Include="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Exclude nfsdk samples and TestSample from compilation -->
  <ItemGroup>
    <Compile Remove="nfsdk\**" />
    <Content Remove="nfsdk\**" />
    <EmbeddedResource Remove="nfsdk\**" />
    <None Remove="nfsdk\**" />
  </ItemGroup>
    <!-- Exclude protocolfilters samples and TestSample from compilation -->
  <ItemGroup>
    <Compile Remove="protocolfilters\**" />
    <Content Remove="protocolfilters\**" />
    <EmbeddedResource Remove="protocolfilters\**" />
    <None Remove="protocolfilters\**" />
  </ItemGroup>

  <!-- Copy native dependencies from Storage/v2.0 to bin/ folder in output -->
  <ItemGroup>
    <None Include="Storage\v2.0\nfapi.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>bin\nfapi.dll</TargetPath>
    </None>
    <None Include="Storage\v2.0\nfdriver.sys">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>bin\nfdriver.sys</TargetPath>
    </None>
    <None Include="Storage\v2.0\nfregdrv.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>bin\nfregdrv.exe</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.24" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.VisualStudio.Threading" Version="17.14.15" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.183">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Socks5" Version="1.0.2" />
    <PackageReference Include="Stun.Net" Version="9.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.8" />
    <PackageReference Include="WindowsFirewallHelper" Version="2.2.0.86" />
  </ItemGroup>

</Project>
