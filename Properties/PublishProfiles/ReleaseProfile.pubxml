<?xml version="1.0" encoding="utf-8"?>
<!--
This profile publishes OmniPoss as a release-ready, reusable package.
Configuration: Release, x64, Windows 10+, ReadyToRun, SingleFile, No Debug Symbols
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishDir>bin\Release\net9.0\publish\OmniPoss.v1.0\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <UseAppHost>true</UseAppHost>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>
</Project>
